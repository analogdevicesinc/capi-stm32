# STM32CubeMX2 code generation backend.
# The classic backend (capi_stm32_config_sdk() in stm32_platform_sdk.cmake) runs
# STM32CubeMX on an INI .ioc file. This backend runs STM32CubeMX2 on a JSON
# .ioc2 file. The extension of the project file selects the backend. See
# capi_stm32_resolve_ioc_file(). STM32C5 is only in the CubeMX2 database.
# The two backends share no code. They have different CLIs, tree layouts and
# CMake integration.

set(_CAPI_STM32_CUBEMX2_DIR "${CMAKE_CURRENT_LIST_DIR}")

# OpenOCD is not configured here. The classic backend reads the .ioc keys. The
# .ioc2 has the board name only (STMicroelectronics::NUCLEO-C5A3ZG@NUC5A3ZG$KR1)
# and no MCU part. sdk/flash.cmake derives the OpenOCD settings from TARGET.

# Check if the CubeMX2 project needs a new generation.
# This is the same check as in the classic backend. The stamp has the hash of
# the .ioc2 file and the path of the `cube` wrapper.
function(capi_stm32_check_cubemx2_stale IOC2_FILE GEN_DIR)
        set(STAMP_FILE "${GEN_DIR}/.cubemx2_stamp")
        set(NEED_REGEN TRUE PARENT_SCOPE)

        if(EXISTS "${IOC2_FILE}")
                file(SHA1 "${IOC2_FILE}" _ioc2_hash)
        else()
                set(_ioc2_hash "MISSING")
        endif()
        set(_current "${_ioc2_hash}:${STM32CUBEMX2_CUBE_EXECUTABLE}")

        # Also require CMakePresets.json. A run that failed after the stamp
        # would look up to date and break add_subdirectory() below.
        if(EXISTS "${STAMP_FILE}" AND EXISTS "${GEN_DIR}/CMakePresets.json")
                file(READ "${STAMP_FILE}" _stored)
                string(STRIP "${_stored}" _stored)
                if("${_current}" STREQUAL "${_stored}")
                        set(NEED_REGEN FALSE PARENT_SCOPE)
                        return()
                endif()
                message(STATUS "STM32CubeMX2 regeneration needed (.ioc2 or cube CLI changed)")
        endif()
endfunction()

# Read the build type name from CMakePresets.json. CubeMX2 names its one visible
# configure preset after the build variant, for example "debug_GCC_NUCLEO-C5A3ZG".
# Each generated CMake fragment tests CMAKE_BUILD_TYPE against this name.
# Sets MX2_BUILD_TYPE in the caller's scope.
function(capi_stm32_read_cubemx2_build_type GEN_DIR)
        set(_presets "${GEN_DIR}/CMakePresets.json")
        if(NOT EXISTS "${_presets}")
                message(FATAL_ERROR
                        "STM32CubeMX2 generated no CMakePresets.json under ${GEN_DIR}. "
                        "Generation may have produced an unexpected layout.")
        endif()
        file(READ "${_presets}" _json)
        string(JSON _count LENGTH "${_json}" configurePresets)
        set(_found "")
        math(EXPR _last "${_count} - 1")
        foreach(_i RANGE 0 ${_last})
                string(JSON _preset GET "${_json}" configurePresets ${_i})
                string(JSON _hidden ERROR_VARIABLE _e GET "${_preset}" hidden)
                if(_hidden STREQUAL "ON" OR _hidden STREQUAL "true")
                        continue()
                endif()
                string(JSON _name GET "${_preset}" name)
                set(_found "${_name}")
                break()
        endforeach()
        if(NOT _found)
                message(FATAL_ERROR
                        "No non-hidden configurePreset in ${_presets}; cannot determine the "
                        "build-type name STM32CubeMX2's generated CMake fragments are guarded on.")
        endif()
        set(MX2_BUILD_TYPE "${_found}" PARENT_SCOPE)
endfunction()

# Replace the generated top-level CMakeLists.txt with a shim for add_subdirectory().
# CubeMX2 generates a standalone project with project(), add_executable() and
# its own toolchain file. The shim keeps the fragments cmake/target.cmake,
# cmake/flags.cmake and cmake/components.cmake. They use ${CMAKE_PROJECT_NAME}
# and ${CMAKE_BUILD_TYPE}, so the shim sets these variables and the fragments
# add their sources to an OBJECT library of capi-stm32.
#
# The shim skips two files. cmake/files.cmake adds main.c, but the application
# provides main(). The toolchain file is not needed, because the capi-stm32
# toolchain sets the MCU flags. The shim sets CPU_FLAGS to empty, so that the
# fragments add no second set of flags.
function(capi_stm32_write_cubemx2_shim GEN_DIR MX2_BUILD_TYPE LIB_NAME)
        file(WRITE "${GEN_DIR}/CMakeLists.txt"
"# Generated by capi-stm32; replaces STM32CubeMX2's standalone project file.
# Regenerated on every CubeMX2 run -- do not edit.

# The CMSIS pack subdirectories of components.cmake call project(). The compiler
# detection would run again without the MCU flags and fail. The CubeMX2
# top-level file sets these variables for the same reason.
set(CMAKE_C_COMPILER_FORCED TRUE)
set(CMAKE_CXX_COMPILER_FORCED TRUE)
set(CMAKE_ASM_COMPILER_FORCED TRUE)

set(CMAKE_BUILD_TYPE \"${MX2_BUILD_TYPE}\")
set(CMAKE_PROJECT_NAME ${LIB_NAME})
set(CPU_FLAGS \"\")

# An OBJECT library needs one source before the fragments add theirs.
file(WRITE \"\${CMAKE_CURRENT_BINARY_DIR}/capi_stm32_mx2_placeholder.c\"
     \"/* placeholder so the OBJECT library has a source of its own */\\n\")
add_library(${LIB_NAME} OBJECT
            \"\${CMAKE_CURRENT_BINARY_DIR}/capi_stm32_mx2_placeholder.c\")

include(cmake/target.cmake)
include(cmake/flags.cmake)
include(cmake/components.cmake)
")
endfunction()

# Remove the newlib system call stubs of ST from the packs that TGT links.
# platform/stm32_capi_uart.c implements _read, _write, _close, _fstat, _isatty
# and _lseek, so that printf() writes to the console UART. The syscalls pack of
# ST defines the same six functions as empty stubs. The link then has six
# duplicate symbols. The classic backend removes syscalls.c from the generated
# build for the same reason (sdk/stm32_patch_cubemx.cmake).
#
# Only syscalls.c goes. sysmem.c has _sbrk, which newlib malloc needs, and
# capi-stm32 does not provide it. libnosys provides the other stubs of
# syscalls.c (_getpid, _kill, _exit and the file calls). The toolchain links it
# with --specs=nosys.specs.
function(capi_stm32_drop_cubemx2_syscalls TGT)
        get_target_property(_libs ${TGT} LINK_LIBRARIES)
        if(NOT _libs)
                return()
        endif()
        foreach(_lib IN LISTS _libs)
                if(NOT TARGET ${_lib})
                        continue()
                endif()
                get_target_property(_srcs ${_lib} INTERFACE_SOURCES)
                if(NOT _srcs)
                        continue()
                endif()
                set(_kept "")
                foreach(_src IN LISTS _srcs)
                        # The pack wraps each path in a generator expression.
                        # Match the file name, not the whole path.
                        if(NOT _src MATCHES "(^|/)syscalls\\.c(>|$)")
                                list(APPEND _kept "${_src}")
                        endif()
                endforeach()
                if(NOT "${_kept}" STREQUAL "${_srcs}")
                        set_target_properties(${_lib} PROPERTIES
                                INTERFACE_SOURCES "${_kept}")
                endif()
        endforeach()
endfunction()

# Set a stack and heap size that a capi application can use.
# CubeMX2 sets STACK_SIZE = 0x400 and HEAP_SIZE = 0x200. It puts the stack and
# the heap in fixed .stack and .heap sections after .bss. The startup code of
# the DFP sets MSPLIM to __StackLimit, so the hardware enforces the limit. In
# classic CubeMX, the sizes are only a link-time check.
# One printf() overruns 1 kB. The core then takes a UsageFault (CFSR STKOF)
# before it sends a character. The board seems to flash and then to do nothing.
#
# The linker script is in user_modifiable/, but the build regenerates it in a
# new directory. So this function applies the sizes each time. A board can set
# CONFIG_STM32_MX2_STACK_SIZE and CONFIG_STM32_MX2_HEAP_SIZE in board.cmake.
# The defaults are 0x2000 for the stack and 0x1000 for the heap.
function(capi_stm32_set_cubemx2_stack_heap LD_FILE)
        if(NOT DEFINED CONFIG_STM32_MX2_STACK_SIZE)
                set(CONFIG_STM32_MX2_STACK_SIZE "0x2000")
        endif()
        if(NOT DEFINED CONFIG_STM32_MX2_HEAP_SIZE)
                set(CONFIG_STM32_MX2_HEAP_SIZE "0x1000")
        endif()

        file(READ "${LD_FILE}" _ld)
        set(_orig "${_ld}")
        string(REGEX REPLACE "STACK_SIZE[ \t]*=[ \t]*[^;]+;"
               "STACK_SIZE = ${CONFIG_STM32_MX2_STACK_SIZE};" _ld "${_ld}")
        string(REGEX REPLACE "HEAP_SIZE[ \t]*=[ \t]*[^;]+;"
               "HEAP_SIZE = ${CONFIG_STM32_MX2_HEAP_SIZE};" _ld "${_ld}")
        if(NOT "${_ld}" STREQUAL "${_orig}")
                file(WRITE "${LD_FILE}" "${_ld}")
        endif()
endfunction()

function(capi_stm32_config_sdk_cubemx2 BUILD_TARGET IOC2_FILE)
        if(NOT STM32CUBEMX2_CUBE_EXECUTABLE)
                message(FATAL_ERROR
                        "Board ${BOARD} uses a .ioc2 project (${IOC2_FILE}), which requires "
                        "STM32CubeMX2, but its 'cube' CLI was not found. Install STM32CubeMX2 "
                        "from https://www.st.com/en/development-tools/stm32cubemx2.html, or set "
                        "STM32CUBEMX2 to the directory containing 'cube'.")
        endif()

        get_filename_component(IOC2_NAME "${IOC2_FILE}" NAME_WE)
        set(GEN_DIR "${CMAKE_CURRENT_BINARY_DIR}/${BOARD}_build/${IOC2_NAME}")

        capi_stm32_check_cubemx2_stale("${IOC2_FILE}" "${GEN_DIR}")

        if(NEED_REGEN)
                # Start with a clean directory. `generate --force` does not
                # remove the files of an earlier configuration.
                file(REMOVE_RECURSE "${GEN_DIR}")
                file(MAKE_DIRECTORY "${GEN_DIR}")

                message(STATUS "Generating STM32CubeMX2 project into ${GEN_DIR}...")
                capi_stm32_run_checked(
                        WHAT "generating the STM32CubeMX2 project"
                        COMMAND ${Python3_EXECUTABLE}
                        "${_CAPI_STM32_CUBEMX2_DIR}/scripts/cubemx2_generate.py"
                        "${STM32CUBEMX2_CUBE_EXECUTABLE}"
                        "${IOC2_FILE}"
                        "${GEN_DIR}"
                )

                capi_stm32_read_cubemx2_build_type("${GEN_DIR}")
                capi_stm32_write_cubemx2_shim("${GEN_DIR}" "${MX2_BUILD_TYPE}" stm32cubemx2)

                if(EXISTS "${IOC2_FILE}")
                        file(SHA1 "${IOC2_FILE}" _ioc2_hash)
                else()
                        set(_ioc2_hash "MISSING")
                endif()
                file(WRITE "${GEN_DIR}/.cubemx2_stamp"
                     "${_ioc2_hash}:${STM32CUBEMX2_CUBE_EXECUTABLE}")
        endif()

        if(NOT TARGET stm32cubemx2)
                add_subdirectory("${GEN_DIR}" "${GEN_DIR}/build")
        endif()

        # Use one link pattern for the generated tree.
        # The CMSIS packs are INTERFACE libraries. They give their sources to
        # each target that links them. components.cmake links them to
        # stm32cubemx2 without a keyword, which sets LINK_LIBRARIES and
        # INTERFACE_LINK_LIBRARIES. The private part compiles the HAL, startup
        # and syscalls into stm32cubemx2. The interface part gives the same
        # sources to each consumer, and the link gets duplicate symbols.
        # Clear the interface part. flags.cmake already set the include paths
        # and defines as PUBLIC usage requirements of stm32cubemx2.
        set_target_properties(stm32cubemx2 PROPERTIES
                INTERFACE_SOURCES ""
                INTERFACE_LINK_LIBRARIES "")

        capi_stm32_drop_cubemx2_syscalls(stm32cubemx2)

        # The capi-stm32 toolchain already has the newlib specs in
        # CMAKE_EXE_LINKER_FLAGS. Remove the ones of flags.cmake. GCC rejects
        # --specs=nosys.specs twice ("attempt to rename spec
        # 'link_gcc_c_sequence' to already defined spec
        # 'nosys_link_gcc_c_sequence'").
        get_target_property(_mx2_link_opts stm32cubemx2 INTERFACE_LINK_OPTIONS)
        if(_mx2_link_opts)
                list(REMOVE_ITEM _mx2_link_opts
                     "--specs=nosys.specs" "--specs=nano.specs")
                set_target_properties(stm32cubemx2 PROPERTIES
                        INTERFACE_LINK_OPTIONS "${_mx2_link_opts}")
        endif()

        # CubeMX2 puts the linker script in user_modifiable/ and names it
        # <part>_flash.ld. Classic CubeMX puts it beside the sources and names it
        # <PART>_FLASH.ld. Check as strictly as the classic backend. No match
        # gives a bare "-T". More than one match passes the extra scripts as
        # input files.
        file(GLOB LINKER_SCRIPT_FILE "${GEN_DIR}/user_modifiable/Device/*/*_flash.ld")
        if(NOT LINKER_SCRIPT_FILE)
                message(FATAL_ERROR
                        "No STM32CubeMX2 linker script (user_modifiable/Device/*/*_flash.ld) "
                        "found under ${GEN_DIR}. Generation may have produced an unexpected layout.")
        endif()
        list(LENGTH LINKER_SCRIPT_FILE _linker_script_count)
        if(_linker_script_count GREATER 1)
                message(FATAL_ERROR
                        "Multiple STM32CubeMX2 linker scripts found under ${GEN_DIR}: "
                        "${LINKER_SCRIPT_FILE}. Expected exactly one.")
        endif()

        capi_stm32_set_cubemx2_stack_heap("${LINKER_SCRIPT_FILE}")

        target_link_libraries(${BUILD_TARGET} PUBLIC stm32cubemx2)
        target_compile_definitions(${BUILD_TARGET} PRIVATE -DSTM32_PLATFORM=1)
        target_link_options(${BUILD_TARGET} PRIVATE -T${LINKER_SCRIPT_FILE})
endfunction()
