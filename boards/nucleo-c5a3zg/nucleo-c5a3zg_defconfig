CONFIG_PLATFORM_DRIVERS=y
CONFIG_STM32=y

CONFIG_UART_STM32=y
CONFIG_UART_STDIO_STM32=y
CONFIG_SPI_STM32=y
CONFIG_I2C_STM32=y
CONFIG_IRQ_STM32=y
CONFIG_GPIO_STM32=y

# This list is shorter than the list of nucleo-h753zi. That board also enables
# CONFIG_DMA_STM32 and CONFIG_GPIO_IRQ_STM32. The new HAL has no porting layer
# for them yet: platform/hal2/ has UART, GPIO, SPI and I2C only. The build
# fails if you enable them here. Add a stm32_hal_port_<iface>.c file first.
#
# The board needs no family symbol. CMakeLists.txt sets CONFIG_STM32_HAL2 from
# TARGET (^stm32c5 selects the new HAL).
